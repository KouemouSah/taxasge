{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Nota de Ingreso - Schema Generique",
  "description": "Schema d'extraction pour Nota de Ingreso. Utilise par TOUS les workflows bases sur ce document.",
  "version": "1.0.0",
  "document_type": "nota_ingreso",

  "required": ["bloc_paiement", "bloc_verification"],

  "properties": {
    "bloc_administratif": {
      "type": "object",
      "description": "Donnees de l'organisme emetteur",
      "properties": {
        "organisme_emetteur": {
          "type": ["string", "null"],
          "description": "Ministere (ex: MINISTERIO DE SEGURIDAD NACIONAL)",
          "db_field": "organisme_emetteur"
        },
        "departement_emetteur": {
          "type": ["string", "null"],
          "description": "Direction (ex: DIRECCION GENERAL DE EXTRANJERIA)",
          "db_field": "departement_emetteur"
        },
        "code_reference": {
          "type": ["string", "null"],
          "description": "Code manuscrit (ex: AA0516)",
          "db_field": "code_reference"
        }
      }
    },

    "bloc_paiement": {
      "type": "object",
      "description": "Informations de paiement",
      "required": ["numero_nota", "montant_chiffre"],
      "properties": {
        "numero_nota": {
          "type": "string",
          "description": "Numero unique (ex: 1.804/10)",
          "db_field": "numero_nota"
        },
        "concepto_pago": {
          "type": ["string", "null"],
          "description": "Description du paiement",
          "db_field": "concepto_pago"
        },
        "periode": {
          "type": ["string", "null"],
          "description": "Periode (ex: 12 meses)",
          "db_field": "periode"
        },
        "montant_chiffre": {
          "type": "number",
          "description": "Montant en chiffres",
          "db_field": "montant_chiffre",
          "minimum": 0
        },
        "montant_lettre": {
          "type": ["string", "null"],
          "description": "Montant en lettres",
          "db_field": "montant_lettre"
        },
        "type_compte": {
          "type": ["string", "null"],
          "enum": ["cuenta_propia", "cuenta_empresa", null],
          "db_field": "type_compte"
        },
        "compte_destinataire": {
          "type": ["string", "null"],
          "description": "Compte destino (TESORERIA)",
          "db_field": "compte_destinataire"
        }
      }
    },

    "bloc_beneficiaire": {
      "type": "object",
      "description": "Demandeur (particulier ou entreprise)",
      "properties": {
        "nom_demandeur": {
          "type": ["string", "null"],
          "description": "Nom personne OU raison sociale",
          "db_field": "nom_demandeur"
        },
        "is_entreprise": {
          "type": "boolean",
          "default": false,
          "description": "true si detecte comme entreprise"
        },
        "nif_entreprise": {
          "type": ["string", "null"],
          "description": "NIF si entreprise"
        },
        "nombre_beneficiaires": {
          "type": ["integer", "null"],
          "description": "Nombre de personnes couvertes",
          "minimum": 1
        }
      }
    },

    "bloc_verification": {
      "type": "object",
      "required": ["date_emission", "dias_validez"],
      "properties": {
        "date_emission": {
          "type": "string",
          "format": "date",
          "description": "Date emission (YYYY-MM-DD)",
          "db_field": "date_emission"
        },
        "dias_validez": {
          "type": "integer",
          "description": "Jours de validite (ex: 15 pour 'se caduca a los 15 dias')",
          "db_field": "dias_validez",
          "minimum": 1,
          "default": 15,
          "extraction_hint": "Chercher 'se caduca a los X dias' ou 'valido por X dias'"
        },
        "fecha_caducidad": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Date d'expiration calculee (date_emission + dias_validez)",
          "db_field": "date_expiration",
          "db_alias": "fecha_caducidad",
          "computed": true
        },
        "lieu_emission": {
          "type": ["string", "null"],
          "description": "Malabo, Bata, etc."
        },
        "signataire": {
          "type": ["string", "null"],
          "description": "Titre du signataire",
          "db_field": "signataire"
        },
        "tampon_officiel": {
          "type": "boolean",
          "default": false,
          "description": "Tampon visible",
          "db_field": "tampon_officiel"
        }
      }
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "campos_extraidos": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Champs avec valeur non-null"
    },

    "campos_no_visibles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Champs avec valeur null"
    }
  },

  "db_mapping": {
    "table": "fiscal_service_data",
    "fields": {
      "bloc_administratif.organisme_emetteur": "organisme_emetteur",
      "bloc_administratif.departement_emetteur": "departement_emetteur",
      "bloc_administratif.code_reference": "code_reference",
      "bloc_paiement.numero_nota": "numero_nota",
      "bloc_paiement.concepto_pago": "concepto_pago",
      "bloc_paiement.periode": "periode",
      "bloc_paiement.montant_chiffre": "montant_chiffre",
      "bloc_paiement.montant_lettre": "montant_lettre",
      "bloc_paiement.type_compte": "type_compte",
      "bloc_paiement.compte_destinataire": "compte_destinataire",
      "bloc_beneficiaire.nom_demandeur": "nom_demandeur",
      "bloc_verification.date_emission": "date_emission",
      "bloc_verification.dias_validez": "dias_validez",
      "bloc_verification.fecha_caducidad": "date_expiration",
      "bloc_verification.signataire": "signataire",
      "bloc_verification.tampon_officiel": "tampon_officiel"
    }
  },

  "required_for_completion": {
    "critical": [
      "numero_nota",
      "concepto_pago",
      "montant_chiffre",
      "date_emission",
      "dias_validez",
      "organisme_emetteur",
      "departement_emetteur"
    ],
    "important": [
      "montant_lettre",
      "periode",
      "type_compte",
      "nom_demandeur",
      "signataire",
      "tampon_officiel",
      "lieu_emission"
    ],
    "optional": [
      "code_reference",
      "compte_destinataire",
      "nif_entreprise",
      "nombre_beneficiaires",
      "fecha_caducidad"
    ]
  },

  "validation_rules": {
    "nota_expirada": {
      "description": "La nota de ingreso ne doit pas etre expiree",
      "rule": "fecha_caducidad >= date_courante",
      "error_message_es": "La nota de ingreso ha caducado. Por favor, solicite una nueva.",
      "error_message_fr": "La nota de ingreso a expire. Veuillez en demander une nouvelle.",
      "severity": "blocking"
    },
    "montant_coherence": {
      "description": "montant_chiffre et montant_lettre doivent correspondre",
      "rule": "Si les deux sont extraits, verifier coherence"
    },
    "tampon_required": {
      "description": "Le tampon officiel doit etre present pour validation",
      "rule": "tampon_officiel == true pour accepter sans review"
    }
  },

  "computed_fields": {
    "fecha_caducidad": {
      "formula": "date_emission + dias_validez days",
      "example": "2025-01-15 + 15 days = 2025-01-30"
    }
  }
}
