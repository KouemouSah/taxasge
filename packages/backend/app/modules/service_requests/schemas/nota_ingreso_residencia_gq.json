{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_id": "NOTA_INGRESO_RESIDENCIA_GQ_V1",
  "version": "1.1",
  "title": "Nota de Ingreso - Residencia (Titre de Sejour) - Guinea Ecuatorial",
  "description": "Schema d'extraction pour la Nota de Ingreso emise par la Direccion General de Extranjeria y Fronteras, utilisee dans le workflow Residencia (titre de sejour)",
  "document_type": "NOTA_INGRESO_RESIDENCIA",
  "country": "GQ",
  "faces": ["single_page"],
  "document_nature": "recu_paiement_officiel",
  "issuer": "Direccion General de Extranjeria y Fronteras",
  "ministry": "Ministerio de Seguridad Nacional",
  "workflow": "residencia",

  "required": ["bloc_paiement", "bloc_verification"],

  "properties": {
    "bloc_administratif": {
      "type": "object",
      "description": "Donnees de l'organisme emetteur",
      "properties": {
        "organisme_emetteur": {
          "type": ["string", "null"],
          "description": "Ministere (MINISTERIO DE SEGURIDAD NACIONAL)",
          "db_field": "organisme_emetteur",
          "default": "MINISTERIO DE SEGURIDAD NACIONAL"
        },
        "departement_emetteur": {
          "type": ["string", "null"],
          "description": "Direction (DIRECCION GENERAL DE EXTRANJERIA Y FRONTERAS)",
          "db_field": "departement_emetteur",
          "default": "DIRECCION GENERAL DE EXTRANJERIA Y FRONTERAS"
        },
        "code_reference": {
          "type": ["string", "null"],
          "description": "Code manuscrit de reference (ex: AA0516)",
          "db_field": "code_reference"
        }
      }
    },

    "bloc_paiement": {
      "type": "object",
      "description": "Informations de paiement pour le titre de sejour",
      "required": ["numero_nota", "montant_chiffre"],
      "properties": {
        "numero_nota": {
          "type": "string",
          "description": "Numero unique de la nota (ex: 1.804/10)",
          "db_field": "numero_nota",
          "pattern": "^[0-9.,]+/[0-9]+$"
        },
        "concepto_pago": {
          "type": ["string", "null"],
          "description": "Concept du paiement (ex: Renovacion de residencia, Primera residencia)",
          "db_field": "concepto_pago"
        },
        "periode": {
          "type": ["string", "null"],
          "description": "Periode de validite (ex: 12 meses)",
          "db_field": "periode"
        },
        "montant_chiffre": {
          "type": "number",
          "description": "Montant en chiffres (FCFA)",
          "db_field": "montant_chiffre",
          "minimum": 0,
          "currency": "XAF"
        },
        "montant_lettre": {
          "type": ["string", "null"],
          "description": "Montant en lettres",
          "db_field": "montant_lettre"
        },
        "type_compte": {
          "type": ["string", "null"],
          "enum": ["cuenta_propia", "cuenta_empresa", null],
          "db_field": "type_compte"
        },
        "compte_destinataire": {
          "type": ["string", "null"],
          "description": "Compte destino (TESORERIA)",
          "db_field": "compte_destinataire"
        }
      }
    },

    "bloc_beneficiaire": {
      "type": "object",
      "description": "Demandeur du titre de sejour",
      "properties": {
        "nom_demandeur": {
          "type": ["string", "null"],
          "description": "Nom complet du demandeur",
          "db_field": "nom_demandeur",
          "pii": true
        },
        "is_entreprise": {
          "type": "boolean",
          "default": false,
          "description": "true si detecte comme entreprise"
        },
        "nif_entreprise": {
          "type": ["string", "null"],
          "description": "NIF si entreprise sponsor"
        },
        "nombre_beneficiaires": {
          "type": ["integer", "null"],
          "description": "Nombre de personnes couvertes (reagrupacion familiale)",
          "minimum": 1
        }
      }
    },

    "bloc_verification": {
      "type": "object",
      "required": ["date_emission", "dias_validez"],
      "properties": {
        "date_emission": {
          "type": "string",
          "format": "date",
          "description": "Date emission (YYYY-MM-DD)",
          "db_field": "date_emission"
        },
        "dias_validez": {
          "type": "integer",
          "description": "Jours de validite (15 jours standard pour residencia)",
          "db_field": "dias_validez",
          "minimum": 1,
          "default": 15,
          "extraction_hint": "Chercher 'se caduca a los X dias' ou 'valido por X dias'"
        },
        "fecha_caducidad": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Date d'expiration calculee (date_emission + dias_validez)",
          "db_field": "date_expiration",
          "computed": true
        },
        "lieu_emission": {
          "type": ["string", "null"],
          "description": "Malabo, Bata, etc."
        },
        "signataire": {
          "type": ["string", "null"],
          "description": "Titre du signataire (Director General de Extranjeria)",
          "db_field": "signataire"
        },
        "tampon_officiel": {
          "type": "boolean",
          "default": false,
          "description": "Tampon Direccion General de Extranjeria visible",
          "db_field": "tampon_officiel"
        }
      }
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "campos_extraidos": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Champs avec valeur non-null"
    },

    "campos_no_visibles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Champs avec valeur null"
    }
  },

  "db_mapping": {
    "table": "fiscal_service_data",
    "fields": {
      "bloc_administratif.organisme_emetteur": "organisme_emetteur",
      "bloc_administratif.departement_emetteur": "departement_emetteur",
      "bloc_administratif.code_reference": "code_reference",
      "bloc_paiement.numero_nota": "numero_nota",
      "bloc_paiement.concepto_pago": "concepto_pago",
      "bloc_paiement.periode": "periode",
      "bloc_paiement.montant_chiffre": "montant_chiffre",
      "bloc_paiement.montant_lettre": "montant_lettre",
      "bloc_paiement.type_compte": "type_compte",
      "bloc_paiement.compte_destinataire": "compte_destinataire",
      "bloc_beneficiaire.nom_demandeur": "nom_demandeur",
      "bloc_verification.date_emission": "date_emission",
      "bloc_verification.dias_validez": "dias_validez",
      "bloc_verification.fecha_caducidad": "date_expiration",
      "bloc_verification.signataire": "signataire",
      "bloc_verification.tampon_officiel": "tampon_officiel"
    }
  },

  "required_for_completion": {
    "critical": [
      "numero_nota",
      "concepto_pago",
      "montant_chiffre",
      "date_emission",
      "dias_validez",
      "organisme_emetteur",
      "departement_emetteur"
    ],
    "important": [
      "montant_lettre",
      "periode",
      "type_compte",
      "nom_demandeur",
      "signataire",
      "tampon_officiel",
      "lieu_emission"
    ],
    "optional": [
      "code_reference",
      "compte_destinataire",
      "nif_entreprise",
      "nombre_beneficiaires",
      "fecha_caducidad"
    ]
  },

  "validations": [
    {
      "id": "nota_no_expirada",
      "rule": "fecha_caducidad >= TODAY",
      "error_es": "La nota de ingreso ha caducado. Por favor, solicite una nueva.",
      "error_fr": "La nota de ingreso a expire. Veuillez en demander une nouvelle.",
      "severity": "error"
    },
    {
      "id": "montant_coherence",
      "rule": "montant_chiffre > 0",
      "error_es": "El monto debe ser mayor a cero",
      "error_fr": "Le montant doit etre superieur a zero",
      "severity": "error"
    },
    {
      "id": "tampon_officiel_present",
      "rule": "tampon_officiel == true",
      "error_es": "La nota debe tener el tampon oficial de Extranjeria",
      "error_fr": "La nota doit avoir le tampon officiel d'Extranjeria",
      "severity": "warning"
    },
    {
      "id": "organisme_is_extranjeria",
      "rule": "organisme_emetteur CONTAINS 'SEGURIDAD' OR departement_emetteur CONTAINS 'EXTRANJERIA'",
      "error_es": "Esta nota de ingreso debe ser emitida por Extranjeria",
      "error_fr": "Cette nota de ingreso doit etre emise par Extranjeria",
      "severity": "error"
    }
  ],

  "computed_fields": {
    "fecha_caducidad": {
      "formula": "date_emission + dias_validez days",
      "example": "2025-01-15 + 15 days = 2025-01-30"
    }
  },

  "gemini_hints": {
    "document_description": "Nota de Ingreso emise par la Direccion General de Extranjeria y Fronteras pour le paiement du titre de sejour (residencia) en Guinee Equatoriale. Document officiel sur papier a en-tete du Ministerio de Seguridad Nacional.",
    "language": "es",
    "date_format": "DD/MM/YYYY",
    "visual_zones": [
      "En-tete: MINISTERIO DE SEGURIDAD NACIONAL / DIRECCION GENERAL DE EXTRANJERIA Y FRONTERAS",
      "Titre: NOTA DE INGRESO (centre, gros caracteres)",
      "Zone gauche: Code reference manuscrit (AA0516 etc.)",
      "Zone centrale: Numero de nota (format X.XXX/XX), Concepto de pago, Periode, Montant en chiffres et en lettres",
      "Zone beneficiaire: Nom du demandeur, type de compte",
      "Bas: Date emission, Lieu (Malabo/Bata), Signature du responsable, Tampon officiel rond bleu",
      "Mention de caducite: 'se caduca a los 15 dias' ou similaire"
    ],
    "common_values": {
      "concepto_pago": [
        "Renovacion de residencia",
        "Primera residencia",
        "Duplicado de residencia",
        "Cambio de datos residencia",
        "Reagrupacion familiar"
      ],
      "lieu_emission": ["Malabo", "Bata"],
      "dias_validez": [15]
    },
    "ocr_challenges": [
      "Montants manuscrits parfois peu lisibles",
      "Code reference manuscrit en coin",
      "Tampon pouvant masquer du texte",
      "Mention 'se caduca' parfois en petits caracteres"
    ]
  },

  "tesseract_patterns": {
    "numero_nota": [
      "(?:N[°oº]?\\s*(?:de\\s*)?(?:nota|ingreso))\\s*[:#]?\\s*([0-9.,]+/[0-9]+)",
      "([0-9]{1,2}\\.[0-9]{3}/[0-9]{1,2})"
    ],
    "concepto_pago": [
      "(?:concepto|por\\s*concepto\\s*de)\\s*[:#]?\\s*(.+?)(?=periodo|monto|$)",
      "(?:Renovaci[oó]n|Primera|Duplicado|Cambio|Reagrupaci[oó]n)\\s*(?:de\\s*)?(?:residencia|tarjeta)"
    ],
    "montant_chiffre": [
      "(?:monto|importe|cantidad)\\s*[:#]?\\s*([0-9.,]+)\\s*(?:FCFA|F\\.?CFA|XAF)?",
      "([0-9]{1,3}(?:[.,][0-9]{3})+)\\s*(?:FCFA|F\\.?CFA)"
    ],
    "montant_lettre": [
      "(?:en\\s*letras?|lettre)\\s*[:#]?\\s*(.+?)(?=fecha|$)"
    ],
    "date_emission": [
      "(?:fecha|Malabo|Bata)\\s*[,:]?\\s*(?:a\\s*)?(\\d{1,2})[/.-](\\d{1,2})[/.-](\\d{2,4})",
      "(\\d{1,2})\\s*de\\s*(\\w+)\\s*de(?:l)?\\s*(\\d{4})"
    ],
    "lieu_emission": [
      "(Malabo|Bata)\\s*[,:]"
    ],
    "dias_validez": [
      "(?:caduca|valido|validez)\\s*(?:a\\s*los)?\\s*(\\d+)\\s*(?:dias|d[ií]as)"
    ],
    "nom_demandeur": [
      "(?:nombre|demandeur|solicitante|a\\s*favor\\s*de)\\s*[:#]?\\s*([A-ZÁÉÍÓÚÑ][A-Za-záéíóúñ\\s]+)"
    ]
  }
}
