# TaxasGE Web - Environment Variables

# Backend API URL
# Local development: http://localhost:8000
# Staging: https://taxasge-backend-staging-xrlbgdr5eq-uc.a.run.app/api/v1
# Production: https://api.taxasge.gq/v1
NEXT_PUBLIC_API_URL=https://taxasge-backend-staging-xrlbgdr5eq-uc.a.run.app/api/v1

# API Version
NEXT_PUBLIC_API_VERSION=v1

# Firebase Configuration (pour PWA/Analytics)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
