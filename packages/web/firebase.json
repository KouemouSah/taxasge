{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/auth/reset-password/confirm",
        "destination": "/auth/reset-password/confirm/index.html"
      }
    ]
  }
}
