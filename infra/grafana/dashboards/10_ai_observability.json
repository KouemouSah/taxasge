{
  "uid": "facil-ai-observability",
  "title": "Facil — AI Observability (Gemini)",
  "tags": ["facil", "ai", "gemini", "cost", "observability"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "fiscalYearStartMonth": 0,
  "editable": false,
  "graphTooltip": 1,
  "links": [
    { "type": "dashboards", "tags": ["facil"], "title": "Facil dashboards", "asDropdown": true, "includeVars": false, "keepTime": true, "icon": "external link" }
  ],
  "templating": {
    "list": [
      {
        "name": "feature",
        "label": "Feature",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "facil-postgres" },
        "query": "SELECT DISTINCT feature FROM ai_call_metrics WHERE \"timestamp\" > now() - interval '30 days' ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "facil-postgres" },
        "query": "SELECT DISTINCT model_name FROM ai_call_metrics WHERE \"timestamp\" > now() - interval '30 days' ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "row", "title": "💰 Cost",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2, "type": "stat", "title": "Cost today (XAF)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "currency:XAF",
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 2000 },
            { "color": "red",    "value": 5000 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT COALESCE(SUM(cost_xaf),0) AS cost FROM ai_call_metrics WHERE \"timestamp\" >= date_trunc('day', now())"
      }]
    },
    {
      "id": 3, "type": "stat", "title": "Cost MTD (XAF)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": { "unit": "currency:XAF", "noValue": "0" }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT COALESCE(SUM(cost_xaf),0) AS cost FROM ai_call_metrics WHERE \"timestamp\" >= date_trunc('month', now())"
      }]
    },
    {
      "id": 4, "type": "stat", "title": "Total calls today",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT count(*)::int AS calls FROM ai_call_metrics WHERE \"timestamp\" >= date_trunc('day', now())"
      }]
    },
    {
      "id": 5, "type": "stat", "title": "Tokens (input/output) today",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT COALESCE(SUM(input_tokens),0) AS \"in\", COALESCE(SUM(output_tokens),0) AS \"out\" FROM ai_call_metrics WHERE \"timestamp\" >= date_trunc('day', now())"
      }]
    },
    {
      "id": 10, "type": "row", "title": "📈 Trends (cost & latency)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 11, "type": "timeseries", "title": "Cost by feature (per day)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "currency:XAF", "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "refId": "A", "format": "time_series",
        "rawSql": "SELECT date_trunc('day', \"timestamp\") AS time, feature AS metric, SUM(cost_xaf) AS value FROM ai_call_metrics WHERE \"timestamp\" > $__timeFrom() AND feature = ANY(string_to_array('${feature:csv}', ',')) AND model_name = ANY(string_to_array('${model:csv}', ',')) GROUP BY 1, 2 ORDER BY 1"
      }]
    },
    {
      "id": 12, "type": "timeseries", "title": "p95 latency by feature (ms)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 0 } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "refId": "A", "format": "time_series",
        "rawSql": "SELECT date_trunc('hour', \"timestamp\") AS time, feature AS metric, percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS value FROM ai_call_metrics WHERE \"timestamp\" > $__timeFrom() AND feature = ANY(string_to_array('${feature:csv}', ',')) AND model_name = ANY(string_to_array('${model:csv}', ',')) GROUP BY 1, 2 ORDER BY 1"
      }]
    },
    {
      "id": 20, "type": "row", "title": "🚨 Errors & reliability",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 21, "type": "stat", "title": "Error rate (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 3 },
            { "color": "red",    "value": 10 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 0 ELSE (sum((status != 'success')::int)::numeric / count(*) * 100) END AS error_pct FROM ai_call_metrics WHERE \"timestamp\" > now() - interval '24 hours'"
      }]
    },
    {
      "id": 22, "type": "barchart", "title": "Errors by status type (last 7d)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 6, "y": 16, "w": 10, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": { "displayMode": "hidden" },
        "tooltip": { "mode": "single" }
      },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT status AS \"Status\", count(*)::int AS \"Count\" FROM ai_call_metrics WHERE \"timestamp\" > now() - interval '7 days' AND status != 'success' GROUP BY 1 ORDER BY 2 DESC"
      }]
    },
    {
      "id": 23, "type": "timeseries", "title": "Calls per hour (success vs error)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "error" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "refId": "A", "format": "time_series",
        "rawSql": "SELECT date_trunc('hour', \"timestamp\") AS time, CASE WHEN status='success' THEN 'success' ELSE 'error' END AS metric, count(*) AS value FROM ai_call_metrics WHERE \"timestamp\" > $__timeFrom() GROUP BY 1, 2 ORDER BY 1"
      }]
    },
    {
      "id": 30, "type": "row", "title": "🔝 Top costs",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 31, "type": "table", "title": "Top features by cost (7d)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "cost_xaf" },     "properties": [{ "id": "unit", "value": "currency:XAF" }, { "id": "displayName", "value": "Cost (XAF)" }] },
          { "matcher": { "id": "byName", "options": "calls" },        "properties": [{ "id": "displayName", "value": "Calls" }] },
          { "matcher": { "id": "byName", "options": "p95_ms" },       "properties": [{ "id": "unit", "value": "ms" }, { "id": "displayName", "value": "p95 latency" }] },
          { "matcher": { "id": "byName", "options": "errors" },       "properties": [{ "id": "displayName", "value": "Errors" }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": true, "reducer": ["sum"], "fields": ["cost_xaf", "calls", "errors"] } },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT feature, count(*)::int AS calls, SUM(cost_xaf) AS cost_xaf, percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms)::int AS p95_ms, SUM((status != 'success')::int)::int AS errors FROM ai_call_metrics WHERE \"timestamp\" > now() - interval '7 days' GROUP BY feature ORDER BY cost_xaf DESC LIMIT 20"
      }]
    },
    {
      "id": 32, "type": "table", "title": "Top prompt hashes by cost (7d)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "cost_xaf" },     "properties": [{ "id": "unit", "value": "currency:XAF" }, { "id": "displayName", "value": "Cost (XAF)" }] },
          { "matcher": { "id": "byName", "options": "calls" },        "properties": [{ "id": "displayName", "value": "Calls" }] },
          { "matcher": { "id": "byName", "options": "avg_in" },       "properties": [{ "id": "displayName", "value": "Avg input tok" }] },
          { "matcher": { "id": "byName", "options": "avg_out" },      "properties": [{ "id": "displayName", "value": "Avg output tok" }] }
        ]
      },
      "options": { "showHeader": true },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT prompt_hash, feature, count(*)::int AS calls, SUM(cost_xaf) AS cost_xaf, ROUND(AVG(input_tokens))::int AS avg_in, ROUND(AVG(output_tokens))::int AS avg_out FROM ai_call_metrics WHERE \"timestamp\" > now() - interval '7 days' AND prompt_hash IS NOT NULL GROUP BY prompt_hash, feature ORDER BY cost_xaf DESC LIMIT 20"
      }]
    },
    {
      "id": 50, "type": "row", "title": "🛡️ Security — Prompt injection",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 51, "type": "stat", "title": "High-risk attempts (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 35, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red",    "value": 5 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT count(*) AS attempts FROM ai_call_metrics WHERE \"timestamp\" > now() - interval '24 hours' AND injection_risk = 'high'"
      }]
    },
    {
      "id": 52, "type": "timeseries", "title": "Injection attempts by risk level (per hour)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 6, "y": 35, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "high" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "medium" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "low" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "refId": "A", "format": "time_series",
        "rawSql": "SELECT date_trunc('hour', \"timestamp\") AS time, injection_risk AS metric, count(*) AS value FROM ai_call_metrics WHERE \"timestamp\" > $__timeFrom() AND injection_risk IN ('low', 'medium', 'high') GROUP BY 1, 2 ORDER BY 1"
      }]
    },
    {
      "id": 53, "type": "barchart", "title": "Top matched rules (7d)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 18, "y": 35, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": { "displayMode": "hidden" },
        "tooltip": { "mode": "single" }
      },
      "targets": [{
        "refId": "A", "format": "table",
        "rawSql": "SELECT rule AS \"Rule\", count(*)::int AS \"Hits\" FROM ai_call_metrics, unnest(injection_rules) AS rule WHERE \"timestamp\" > now() - interval '7 days' AND injection_rules IS NOT NULL GROUP BY rule ORDER BY 2 DESC LIMIT 10"
      }]
    },
    {
      "id": 40, "type": "row", "title": "🤖 Models breakdown",
      "collapsed": true,
      "gridPos": { "x": 0, "y": 43, "w": 24, "h": 1 },
      "panels": [
        {
          "id": 41, "type": "piechart", "title": "Cost share by model (7d)",
          "datasource": { "type": "postgres", "uid": "facil-postgres" },
          "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
          "fieldConfig": { "defaults": { "unit": "currency:XAF" } },
          "options": {
            "pieType": "donut",
            "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
          },
          "targets": [{
            "refId": "A", "format": "table",
            "rawSql": "SELECT model_name AS metric, SUM(cost_xaf) AS value FROM ai_call_metrics WHERE \"timestamp\" > now() - interval '7 days' GROUP BY 1 ORDER BY 2 DESC"
          }]
        },
        {
          "id": 42, "type": "table", "title": "Calls/cost by model (7d)",
          "datasource": { "type": "postgres", "uid": "facil-postgres" },
          "gridPos": { "x": 12, "y": 44, "w": 12, "h": 8 },
          "fieldConfig": {
            "defaults": {},
            "overrides": [
              { "matcher": { "id": "byName", "options": "cost_xaf" }, "properties": [{ "id": "unit", "value": "currency:XAF" }] },
              { "matcher": { "id": "byName", "options": "p95_ms" },   "properties": [{ "id": "unit", "value": "ms" }] }
            ]
          },
          "options": { "showHeader": true },
          "targets": [{
            "refId": "A", "format": "table",
            "rawSql": "SELECT model_name, count(*)::int AS calls, SUM(input_tokens)::int AS in_tok, SUM(output_tokens)::int AS out_tok, SUM(cost_xaf) AS cost_xaf, percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms)::int AS p95_ms FROM ai_call_metrics WHERE \"timestamp\" > now() - interval '7 days' GROUP BY model_name ORDER BY cost_xaf DESC"
          }]
        }
      ]
    }
  ]
}
