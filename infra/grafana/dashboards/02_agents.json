    },
    {
      "id": 41,
      "type": "heatmap",
      "title": "Heatmap décisions agent × jour",
      "datasource": {
        "type": "postgres",
        "uid": "facil-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
