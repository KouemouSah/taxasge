          "rawSql": "SELECT report_date AS time, SUM(total_actions) FILTER (WHERE is_oms) AS \"OMS\", SUM(total_actions) FILTER (WHERE NOT is_oms) AS \"non-OMS\" FROM v_agent_workload_enriched WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND entity_code IN (${entity:sqlstring}) AND COALESCE(location_city, 'unassigned') IN (${location:sqlstring}) GROUP BY report_date ORDER BY report_date"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Durée P50 quotidienne (s)",
      "datasource": {
        "type": "postgres",
        "uid": "facil-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT report_date AS time, AVG(p50_duration_seconds) FILTER (WHERE is_oms)::numeric(10,1) AS \"OMS P50\", AVG(p50_duration_seconds) FILTER (WHERE NOT is_oms)::numeric(10,1) AS \"non-OMS P50\" FROM v_agent_workload_enriched WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND entity_code IN (${entity:sqlstring}) AND COALESCE(location_city, 'unassigned') IN (${location:sqlstring}) GROUP BY report_date ORDER BY report_date"
        }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "Heatmap activité (agent × jour)",
