        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT report_date AS time, agent_name AS y, total_actions AS value FROM v_agent_workload_enriched WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('${is_oms}' = '*' OR is_oms::text = '${is_oms}') AND entity_code IN (${entity:sqlstring}) AND COALESCE(location_city, 'unassigned') IN (${location:sqlstring}) ORDER BY agent_name, report_date"
        }
