{
  "uid": "facil-agents",
  "title": "Facil — Performance Agentes",
  "tags": ["facil", "agents"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-90d", "to": "now" },
  "fiscalYearStartMonth": 0,
  "editable": false,
  "graphTooltip": 0,
  "links": [
    { "type": "dashboards", "tags": ["facil"], "title": "Facil dashboards", "asDropdown": true, "includeVars": false, "keepTime": true, "icon": "external link" }
  ],
  "templating": {
    "list": [
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "facil-postgres" },
        "query": "SELECT DISTINCT agent_name FROM vw_agent_daily_workload WHERE agent_name IS NOT NULL ORDER BY agent_name",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 1
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "Synthèse", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 2, "type": "stat", "title": "Décisions totales",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT COALESCE(SUM(total_actions), 0) AS total FROM vw_agent_daily_workload WHERE report_date BETWEEN $__timeFrom() AND $__timeTo()" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Approuvés",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 6, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT COALESCE(SUM(approved), 0) AS approved FROM vw_agent_daily_workload WHERE report_date BETWEEN $__timeFrom() AND $__timeTo()" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "Rejetés",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 10, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT COALESCE(SUM(rejected), 0) AS rejected FROM vw_agent_daily_workload WHERE report_date BETWEEN $__timeFrom() AND $__timeTo()" }
      ]
    },
    {
      "id": 5, "type": "stat", "title": "Taux d'approbation",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 14, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 60 }, { "color": "green", "value": 80 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT (COALESCE(SUM(approved), 0) * 100.0 / NULLIF(SUM(total_actions), 0))::numeric(10,2) AS rate FROM vw_agent_daily_workload WHERE report_date BETWEEN $__timeFrom() AND $__timeTo()" }
      ]
    },
    {
      "id": 6, "type": "stat", "title": "Durée moyenne (s)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT AVG(avg_duration_seconds)::numeric(10,2) AS avg_dur FROM vw_agent_daily_workload WHERE report_date BETWEEN $__timeFrom() AND $__timeTo()" }
      ]
    },

    { "id": 10, "type": "row", "title": "Ranking & distribution", "collapsed": false, "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 11, "type": "barchart", "title": "Top 10 agents (volume)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 9 },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT agent_name, SUM(total_actions) AS \"Décisions\" FROM vw_agent_daily_workload WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('$agent' = 'All' OR agent_name IN ($agent)) GROUP BY agent_name ORDER BY \"Décisions\" DESC LIMIT 10" }
      ]
    },
    {
      "id": 12, "type": "table", "title": "Tableau complet des agents",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Durée moy (s)" }, "properties": [{ "id": "unit", "value": "s" }] },
          { "matcher": { "id": "byName", "options": "P50 (s)" }, "properties": [{ "id": "unit", "value": "s" }] }
        ]
      },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT agent_name AS \"Agent\", SUM(total_actions) AS \"Total\", SUM(approved) AS \"Approuvés\", SUM(rejected) AS \"Rejetés\", AVG(avg_duration_seconds)::numeric(10,2) AS \"Durée moy (s)\", AVG(p50_duration_seconds)::numeric(10,2) AS \"P50 (s)\" FROM vw_agent_daily_workload WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('$agent' = 'All' OR agent_name IN ($agent)) GROUP BY agent_name ORDER BY \"Total\" DESC" }
      ]
    },

    { "id": 20, "type": "row", "title": "Évolution temporelle", "collapsed": false, "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 21, "type": "timeseries", "title": "Approuvés / Rejetés par jour",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 16, "w": 16, "h": 8 },
      "targets": [
        { "refId": "A", "format": "time_series",
          "rawSql": "SELECT report_date AS time, SUM(approved) AS \"Approuvés\", SUM(rejected) AS \"Rejetés\" FROM vw_agent_daily_workload WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('$agent' = 'All' OR agent_name IN ($agent)) GROUP BY report_date ORDER BY report_date" }
      ]
    },
    {
      "id": 22, "type": "timeseries", "title": "Durée P50 (s) par jour",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "format": "time_series",
          "rawSql": "SELECT report_date AS time, AVG(p50_duration_seconds)::numeric(10,2) AS \"P50\" FROM vw_agent_daily_workload WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('$agent' = 'All' OR agent_name IN ($agent)) GROUP BY report_date ORDER BY report_date" }
      ]
    }
  ]
}
