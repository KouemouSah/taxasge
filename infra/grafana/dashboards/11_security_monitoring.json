{
  "uid": "facil-security-monitoring",
  "title": "Facil — Security Monitoring",
  "tags": ["facil", "security", "ip", "device", "geo"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "editable": false,
  "graphTooltip": 1,
  "links": [
    { "type": "dashboards", "tags": ["facil"], "title": "Facil dashboards", "asDropdown": true, "includeVars": false, "keepTime": true, "icon": "external link" }
  ],
  "templating": {
    "list": [
      {
        "name": "device_type",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "facil-postgres" },
        "query": "SELECT DISTINCT device_type FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' AND device_type IS NOT NULL ORDER BY 1",
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "country",
        "label": "Country",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "facil-postgres" },
        "query": "SELECT DISTINCT geo_country FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' AND geo_country IS NOT NULL ORDER BY 1",
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "user_role",
        "label": "User role",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "facil-postgres" },
        "query": "SELECT DISTINCT user_role FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' AND user_role IS NOT NULL ORDER BY 1",
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "📊 Overview", "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 2, "type": "stat", "title": "Total requests (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 1, "w": 5, "h": 5 },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT count(*)::int AS requests FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours'" }]
    },
    {
      "id": 3, "type": "stat", "title": "Unique IPs (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 5, "y": 1, "w": 5, "h": 5 },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT count(DISTINCT ip_address)::int AS ips FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours'" }]
    },
    {
      "id": 4, "type": "stat", "title": "Error rate %",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 10, "y": 1, "w": 5, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "percent", "noValue": "0",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "yellow", "value": 5 },
          { "color": "red",    "value": 15 }
        ]}}},
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 0 ELSE (sum((status_code >= 400)::int)::numeric / count(*) * 100) END AS error_pct FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours'" }]
    },
    {
      "id": 5, "type": "stat", "title": "Bot share %",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 15, "y": 1, "w": 4, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "percent", "noValue": "0",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "yellow", "value": 30 },
          { "color": "red",    "value": 50 }
        ]}}},
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 0 ELSE (sum(is_bot::int)::numeric / count(*) * 100) END AS bot_pct FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours'" }]
    },
    {
      "id": 6, "type": "stat", "title": "Suspicious requests",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 19, "y": 1, "w": 5, "h": 5 },
      "fieldConfig": { "defaults": { "noValue": "0",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "red",    "value": 1 }
        ]}}},
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT count(*)::int AS suspicious FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' AND is_suspicious = true" }]
    },

    { "id": 10, "type": "row", "title": "🌍 Geographic activity", "collapsed": false,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 11, "type": "barchart", "title": "Top 10 countries (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "displayMode": "hidden" } },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT COALESCE(geo_country_name, geo_country, 'Unknown') AS \"Country\", count(*)::int AS \"Requests\" FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' GROUP BY 1 ORDER BY 2 DESC LIMIT 10" }]
    },
    {
      "id": 12, "type": "timeseries", "title": "Request rate by country (top 5)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 20 } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [{ "refId": "A", "format": "time_series",
        "rawSql": "WITH top5 AS (SELECT geo_country FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' AND geo_country IS NOT NULL GROUP BY 1 ORDER BY count(*) DESC LIMIT 5) SELECT date_trunc('hour', \"timestamp\") AS time, geo_country AS metric, count(*) AS value FROM request_telemetry WHERE \"timestamp\" > $__timeFrom() AND geo_country IN (SELECT geo_country FROM top5) GROUP BY 1, 2 ORDER BY 1" }]
    },

    { "id": 20, "type": "row", "title": "📱 Device & browser", "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 21, "type": "piechart", "title": "Device type breakdown (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT COALESCE(device_type, 'unknown') AS metric, count(*) AS value FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' GROUP BY 1 ORDER BY 2 DESC" }]
    },
    {
      "id": 22, "type": "table", "title": "Top browser × OS (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "options": { "showHeader": true },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT browser_name AS \"Browser\", os_name AS \"OS\", count(*)::int AS \"Calls\" FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' AND browser_name IS NOT NULL GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 15" }]
    },
    {
      "id": 23, "type": "timeseries", "title": "Device type rate over time",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "refId": "A", "format": "time_series",
        "rawSql": "SELECT date_trunc('hour', \"timestamp\") AS time, COALESCE(device_type, 'unknown') AS metric, count(*) AS value FROM request_telemetry WHERE \"timestamp\" > $__timeFrom() GROUP BY 1, 2 ORDER BY 1" }]
    },

    { "id": 30, "type": "row", "title": "🚦 IPs & users", "collapsed": false,
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 31, "type": "table", "title": "Top 20 IPs by request count (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "errors" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }] }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": true, "reducer": ["sum"], "fields": ["calls", "errors"] } },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT ip_address::text AS \"IP\", COALESCE(geo_country, '-') AS \"Country\", count(*)::int AS calls, sum((status_code >= 400)::int)::int AS errors, max(\"timestamp\") AS \"Last seen\" FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' AND ip_address IS NOT NULL GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 20" }]
    },
    {
      "id": 32, "type": "timeseries", "title": "New IPs per hour (anomaly indicator)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 20 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "refId": "A", "format": "time_series",
        "rawSql": "WITH first_seen AS (SELECT ip_address, min(\"timestamp\") AS first_ts FROM request_telemetry WHERE \"timestamp\" > now() - interval '7 days' GROUP BY 1) SELECT date_trunc('hour', first_ts) AS time, 'new_ips' AS metric, count(*) AS value FROM first_seen WHERE first_ts > $__timeFrom() GROUP BY 1 ORDER BY 1" }]
    },

    { "id": 40, "type": "row", "title": "🔥 Errors & security", "collapsed": false,
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 41, "type": "barchart", "title": "Top 10 paths returning 4xx (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 35, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal", "showValue": "always", "legend": { "displayMode": "hidden" } },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT path AS \"Path\", count(*)::int AS \"4xx Hits\" FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' AND status_code >= 400 AND status_code < 500 GROUP BY 1 ORDER BY 2 DESC LIMIT 10" }]
    },
    {
      "id": 42, "type": "table", "title": "Failed logins by IP (24h)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 12, "y": 35, "w": 12, "h": 8 },
      "options": { "showHeader": true },
      "targets": [{ "refId": "A", "format": "table",
        "rawSql": "SELECT ip_address::text AS \"IP\", count(*)::int AS \"Failed logins\", max(\"timestamp\") AS \"Last attempt\" FROM request_telemetry WHERE \"timestamp\" > now() - interval '24 hours' AND path LIKE '%login%' AND status_code IN (401, 403) GROUP BY 1 ORDER BY 2 DESC LIMIT 15" }]
    },
    {
      "id": 43, "type": "timeseries", "title": "AI injection attempts per hour (cross-link with AI dashboard)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 43, "w": 24, "h": 7 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "high" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "medium" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "refId": "A", "format": "time_series",
        "rawSql": "SELECT date_trunc('hour', \"timestamp\") AS time, injection_risk AS metric, count(*) AS value FROM ai_call_metrics WHERE \"timestamp\" > $__timeFrom() AND injection_risk IN ('medium', 'high') GROUP BY 1, 2 ORDER BY 1" }]
    }
  ]
}
