{
  "uid": "facil-treasury",
  "title": "Facil — Recaudación Fiscal",
  "tags": ["facil", "treasury", "recaudacion"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-90d", "to": "now" },
  "fiscalYearStartMonth": 0,
  "editable": false,
  "graphTooltip": 0,
  "links": [
    { "type": "dashboards", "tags": ["facil"], "title": "Facil dashboards", "asDropdown": true, "includeVars": false, "keepTime": true, "icon": "external link" }
  ],
  "templating": {
    "list": [
      {
        "name": "entity",
        "label": "Entité",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "facil-postgres" },
        "query": "SELECT DISTINCT entity_code FROM vw_treasury_daily_kpis WHERE entity_code IS NOT NULL ORDER BY entity_code",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 1
      },
      {
        "name": "method",
        "label": "Méthode",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "facil-postgres" },
        "query": "SELECT DISTINCT payment_method FROM vw_treasury_daily_kpis WHERE payment_method IS NOT NULL ORDER BY payment_method",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 1
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "Synthèse", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": [] },

    {
      "id": 2, "type": "stat", "title": "Total recaudado (période)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "currencyXOF", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT COALESCE(SUM(total_amount), 0) AS total FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('$entity' = 'All' OR entity_code IN ($entity)) AND ('$method' = 'All' OR payment_method IN ($method))" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Paiements (count)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 6, "y": 1, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT COALESCE(SUM(payment_count), 0) AS count FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo()" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "Complétés",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 10, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT COALESCE(SUM(completed_count), 0) AS done FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo()" }
      ]
    },
    {
      "id": 5, "type": "stat", "title": "Rejetés",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 14, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT COALESCE(SUM(rejected_count), 0) AS rej FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo()" }
      ]
    },
    {
      "id": 6, "type": "stat", "title": "SLA breach",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT COALESCE(SUM(sla_breached_count), 0) AS sla FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo()" }
      ]
    },

    { "id": 10, "type": "row", "title": "Évolution temporelle", "collapsed": false, "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 11, "type": "timeseries", "title": "Recaudación quotidienne",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 6, "w": 16, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyXOF" } },
      "targets": [
        { "refId": "A", "format": "time_series",
          "rawSql": "SELECT report_date AS time, SUM(total_amount) AS \"Total\" FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('$entity' = 'All' OR entity_code IN ($entity)) AND ('$method' = 'All' OR payment_method IN ($method)) GROUP BY report_date ORDER BY report_date" }
      ]
    },
    {
      "id": 12, "type": "piechart", "title": "Répartition par méthode",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "options": { "pieType": "donut", "displayLabels": ["name", "percent"] },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT payment_method, SUM(total_amount) AS amount FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('$entity' = 'All' OR entity_code IN ($entity)) GROUP BY payment_method ORDER BY amount DESC" }
      ]
    },

    { "id": 20, "type": "row", "title": "Par entité & service", "collapsed": false, "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 21, "type": "barchart", "title": "Total par entité (top 15)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyXOF" } },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT entity_name, SUM(total_amount) AS amount FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('$method' = 'All' OR payment_method IN ($method)) GROUP BY entity_name ORDER BY amount DESC LIMIT 15" }
      ]
    },
    {
      "id": 22, "type": "barchart", "title": "Top 10 services (workflow_code)",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyXOF" } },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT workflow_code, SUM(total_amount) AS amount FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() AND ('$entity' = 'All' OR entity_code IN ($entity)) GROUP BY workflow_code ORDER BY amount DESC LIMIT 10" }
      ]
    },

    { "id": 30, "type": "row", "title": "Pivot détail", "collapsed": true, "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 31, "type": "table", "title": "Pivot entité × méthode",
      "datasource": { "type": "postgres", "uid": "facil-postgres" },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "fieldConfig": { "defaults": { "unit": "currencyXOF" } },
      "targets": [
        { "refId": "A", "format": "table",
          "rawSql": "SELECT entity_name AS \"Entité\", payment_method AS \"Méthode\", SUM(total_amount) AS \"Total\", SUM(payment_count) AS \"Paiements\", AVG(avg_processing_minutes)::numeric(10,2) AS \"Tps moy. (min)\" FROM vw_treasury_daily_kpis WHERE report_date BETWEEN $__timeFrom() AND $__timeTo() GROUP BY entity_name, payment_method ORDER BY \"Total\" DESC" }
      ]
    }
  ]
}
