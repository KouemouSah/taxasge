      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT report_date AS time, SUM(total_amount) AS \"Bundle\" FROM mv_treasury_daily_kpis WHERE workflow_code = 'BUNDLE_PAYMENT' AND report_date BETWEEN $__timeFrom() AND $__timeTo() GROUP BY report_date ORDER BY report_date"
        }
      ]
    },
    {
      "id": 32,
      "type": "table",
      "title": "Top entités bundle",
      "datasource": {
        "type": "postgres",
        "uid": "facil-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 27,
        "w": 8,
        "h": 8
