      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ministry_id AS \"Ministry\", fee_type AS \"Fee\", zone_code AS \"Zone\", SUM(companies_count) AS \"Entreprises\", SUM(obligations_count) AS \"Obligations\", SUM(paid_count) AS \"Payées\", SUM(overdue_count) AS \"Retard\", SUM(total_amount) AS \"Total (XAF)\", SUM(paid_amount) AS \"Payé (XAF)\", SUM(overdue_amount) AS \"Retard (XAF)\", (SUM(paid_amount) * 100.0 / NULLIF(SUM(total_amount), 0))::numeric(10,2) AS \"Recovery %\" FROM mv_obligation_stats_by_ministry WHERE ministry_id::text IN (${ministry:sqlstring}) AND fee_type IN (${fee_type:sqlstring}) AND zone_code IN (${zone:sqlstring}) GROUP BY ministry_id, fee_type, zone_code ORDER BY \"Total (XAF)\" DESC"
        }
