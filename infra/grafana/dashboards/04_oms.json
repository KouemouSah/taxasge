          "refId": "A",
          "format": "table",
          "rawSql": "SELECT (COALESCE(SUM(paid_amount), 0) * 100.0 / NULLIF(SUM(total_amount), 0))::numeric(10,2) FROM mv_obligation_stats_by_ministry WHERE ministry_id::text IN (${ministry:sqlstring}) AND fee_type IN (${fee_type:sqlstring}) AND zone_code IN (${zone:sqlstring})"
