          "format": "table",
          "rawSql": "SELECT zone_code AS \"Zone\", (SUM(paid_amount) * 100.0 / NULLIF(SUM(total_amount), 0))::numeric(10,2) AS \"Recovery %\" FROM mv_obligation_stats_by_ministry WHERE ministry_id::text IN (${ministry:sqlstring}) AND fee_type IN (${fee_type:sqlstring}) GROUP BY zone_code ORDER BY zone_code"
