          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(obligations_count), 0) FROM mv_obligation_stats_by_ministry WHERE ministry_id::text IN (${ministry:sqlstring}) AND fee_type IN (${fee_type:sqlstring}) AND zone_code IN (${zone:sqlstring})"
