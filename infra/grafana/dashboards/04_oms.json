      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT fee_type AS \"Type\", SUM(total_amount) AS \"Total\", SUM(paid_amount) AS \"Payé\", SUM(overdue_amount) AS \"Retard\" FROM mv_obligation_stats_by_ministry WHERE ministry_id::text IN (${ministry:sqlstring}) AND zone_code IN (${zone:sqlstring}) GROUP BY fee_type ORDER BY \"Total\" DESC"
