    "facil",
    "oms",
    "obligations",
    "inspections"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "facil"
      ],
      "title": "Facil dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ministry",
        "label": "Ministère",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "facil-postgres"
        },
        "query": "SELECT DISTINCT ministry_id::text FROM mv_obligation_stats_by_ministry WHERE ministry_id IS NOT NULL ORDER BY ministry_id::text",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "fee_type",
        "label": "Fee type",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "facil-postgres"
        },
        "query": "SELECT DISTINCT fee_type FROM mv_obligation_stats_by_ministry WHERE fee_type IS NOT NULL ORDER BY fee_type",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "zone",
        "label": "Zone",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "facil-postgres"
        },
        "query": "SELECT DISTINCT zone_code FROM mv_obligation_stats_by_ministry WHERE zone_code IS NOT NULL ORDER BY zone_code",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "facil-postgres"
        },
        "query": "SELECT DISTINCT city AS __text, city AS __value FROM v_entity_locations_browse WHERE city IS NOT NULL ORDER BY city",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
