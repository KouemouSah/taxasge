# TaxasGE - Production .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
ENV/
env/
.venv

# Testing & Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/
test_results.txt
test-results/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
dist/
.next/
out/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
service-account-*.json

# Logs
*.log
logs/
*.log.*

# Temporary files
*.tmp
*.temp
.cache/
.temp/
COMMIT_MESSAGE.txt
FILES_SUMMARY.txt
TREE_STRUCTURE.txt
IMPLEMENTATION_REPORT.md
MANUEL_TEST.md
QUICK_START.md

# OS
.DS_Store
Thumbs.db
desktop.ini

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Google Cloud
gcloud-config/
.gcloud/

# Claude Code (keep agent files but ignore session data)
.claude/.agent/Sessions/
.claude/settings.local.json

# Documentation drafts (keep final docs only)
**/RAPPORT_DRAFT_*.md
**/WIP_*.md

# Firebase Service Account Keys (CRITICAL SECURITY)
**/taxasge-*-firebase-adminsdk-*.json
config/*.json

# Additional build artifacts
**/tsconfig.tsbuildinfo
**/coverage/

# IDE specific
.vs/

# Environment examples (keep templates)
!**/.env.example
!**/.env.*.example
